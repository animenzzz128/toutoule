# Copy this file to .env and replace the fake values. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-replace-with-your-key
DATABASE_URL=sqlite:///data/toutoule.db
# Minimum match score (0-100) for a job to reach the digest.
MATCH_THRESHOLD=65
# Model used for extraction. Optional; defaults to claude-haiku-4-5.
EXTRACTION_MODEL=claude-haiku-4-5
# Optional until the mailer lands (Task 2.6).
DIGEST_EMAIL_TO=you@example.com
